# Copy this to .env.local and fill in the values; .env.local is not committed
# Variables that reach client code must carry the framework's prefix (VITE_ for Vite, NEXT_PUBLIC_ for Next.js)

# Backend API base URL, replaced per environment
VITE_API_BASE_URL=https://api.example.com
# Current environment marker, used in code to branch between development and production
VITE_APP_ENV=development

# Used only by build scripts or CI; no prefix, so it never lands in the client bundle
SENTRY_AUTH_TOKEN=
