{
  // Format on save, removing one more "forgot to run format"
  "editor.formatOnSave": true,
  // Prettier throughout, rather than each editor's own default formatter
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  // Run the fixable part of lint and style checking on save; the rest is CI's job
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.fixAll.stylelint": "explicit"
  },
  // Flat config has been the only entry point since ESLint 9
  "eslint.useFlatConfig": true,
  // Files of these types go to the stylelint extension
  "stylelint.validate": ["css", "scss", "less"],
  // Aligned with prettier's endOfLine: lf
  "files.eol": "\n"
}
