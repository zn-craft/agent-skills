{
  // The application's main config. Build scripts, tests and library output each
  // get their own tsconfig.<purpose>.json that reuses this one through extends.
  "compilerOptions": {
    // Compile target: syntax and built-in APIs are judged against this version,
    // and the bundler downgrades the output further
    "target": "ES2022",
    // Available built-in types: the ES library plus the browser DOM; drop DOM for
    // a package that only runs on Node
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // Keep ESNext module syntax in source and let the bundler downgrade it
    "module": "ESNext",
    // Let the bundler resolve module paths, which Vite, webpack and Rspack all do
    "moduleResolution": "bundler",
    // Delete this line when the framework does not process JSX
    "jsx": "preserve",

    // The master strictness switch. The three below are not part of strict and
    // are listed separately; an existing project turns them on a step at a time
    "strict": true,
    // Index access yields undefined too, so arrays and Record lookups are checked first
    "noUncheckedIndexedAccess": true,
    // An unused local is an error
    "noUnusedLocals": true,
    // An unused parameter is an error; delete the parameters that are not needed
    "noUnusedParameters": true,
    // Every switch case has to break, return or throw, so nothing falls through
    "noFallthroughCasesInSwitch": true,

    // Type-only imports must be written import type, leaving no runtime code behind
    "verbatimModuleSyntax": true,
    // Every file can be transpiled on its own, which is what lets esbuild and SWC
    // compile file by file
    "isolatedModules": true,
    // Allow importing JSON, so config and data files can be referenced directly
    "resolveJsonModule": true,
    // Let default imports work against CommonJS dependencies
    "esModuleInterop": true,
    // Skip type checking of third-party packages, which keeps checks fast
    "skipLibCheck": true,
    // Type checking only; the bundler produces the output
    "noEmit": true
  },
  // Cover every source directory; build output and dependencies do not belong here
  "include": ["src"]
}
